			"name": "11. Listar con Filtro – type y priority",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/v1/requests?type=technical_support&priority=high",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "requests"],
					"query": [
						{"key": "type", "value": "technical_support"},
						{"key": "priority", "value": "high"}
					]
				}
			},
			"response": []
		},
		{
			"name": "12. Obtener ServiceRequest por ID (variable)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
