				"url": {
					"raw": "{{base_url}}/api/v1/solicitudes?tipo=soporte_tecnico&prioridad=alta",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "solicitudes"],
					"query": [
						{"key": "tipo", "value": "soporte_tecnico"},
						{"key": "prioridad", "value": "alta"}
					]
				}
			},
			"response": []
		},
		{
			"name": "12. Obtener Solicitud por ID (variable)",
			"request": {
				"method": "GET",
