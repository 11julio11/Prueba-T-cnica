{
	"info": {
		"name": "Prueba Técnica Backend – Solicitudes Institucionales",
		"description": "Colección para probar el servicio de gestión de requests institucionales. Base URL: http://localhost:8000",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		},
		{
			"key": "request_id",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/health",
					"host": ["{{base_url}}"],
					"path": ["health"]
				}
			},
			"response": []
		},
		{
			"name": "2. DB Readiness Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/health/ready",
					"host": ["{{base_url}}"],
					"path": ["health", "ready"]
				}
			},
			"response": []
		},
		{
			"name": "3. Crear ServiceRequest – Soporte Técnico (201)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var json = pm.response.json();",
							"pm.collectionVariables.set('request_id', json.id);",
							"pm.test('Status 201', function(){ pm.response.to.have.status(201); });",
							"pm.test('Status inicial es received', function(){ pm.expect(json.status).to.eql('received'); });"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{"key": "Content-Type", "value": "application/json", "type": "text"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"external_id\": \"EXT-TEST-001\",\n    \"type\": \"technical_support\",\n    \"requester_name\": \"Test User\",\n    \"email\": \"test.user@example.com\",\n    \"description\": \"No puedo acceder al sistema de notas desde ayer en la mañana\",\n    \"priority\": \"high\"\n}",
					"options": {"raw": {"language": "json"}}
				},
				"url": {
					"raw": "{{base_url}}/api/v1/requests",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "requests"]
				}
			},
			"response": []
		},
		{
			"name": "4. Crear ServiceRequest – Acceso Plataforma (201)",
