			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/v1/requests",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "requests"]
				}
			},
			"response": []
		},
		{
			"name": "10. Listar con Filtro – status=received",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/v1/requests?status=received",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "requests"],
					"query": [{"key": "status", "value": "received"}]
				}
			},
			"response": []
		},
