		{
			"name": "7. Crear Solicitud – DUPLICADA (409)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status 409 Conflict', function(){ pm.response.to.have.status(409); });",
							"pm.test('Error de duplicado en respuesta', function(){",
							"    var json = pm.response.json();",
							"    pm.expect(json.detail).to.include('123e4567-e89b-12d3-a456-426614174001');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{"key": "Content-Type", "value": "application/json", "type": "text"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"external_id\": \"123e4567-e89b-12d3-a456-426614174001\",\n    \"type\": \"technical_support\",\n    \"requester_name\": \"Test User\",\n    \"email\": \"test.user@example.com\",\n    \"description\": \"Intento duplicar el external_id 123e4567-e89b-12d3-a456-426614174001\",\n    \"priority\": \"low\"\n}",
					"options": {"raw": {"language": "json"}}
				},
				"url": {
					"raw": "{{base_url}}/api/v1/requests",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "requests"]
				},
				"description": "Debe devolver 409 porque el external_id ya existe (ejecutar después del request 3)."
			},
			"response": []
		},
