					{"key": "Content-Type", "value": "application/json", "type": "text"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"status\": \"in_progress\"\n}",
					"options": {"raw": {"language": "json"}}
				},
				"url": {
					"raw": "{{base_url}}/api/v1/requests/{{request_id}}/status",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "requests", "{{request_id}}", "status"]
				}
			},
			"response": []
