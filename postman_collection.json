{
	"info": {
		"name": "Prueba Técnica Backend – Solicitudes Institucionales",
		"description": "Colección para probar el servicio de gestión de solicitudes institucionales. Base URL: http://localhost:8000\n\nFlujo recomendado:\n1. Ejecutar request 3 (Crear) → captura automáticamente `request_id` en `external_id`\n2. Usar requests 12-16 con la variable `{{request_id}}`",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		},
		{
			"key": "request_id",
			"value": "",
			"type": "string",
			"description": "Se auto-rellena al ejecutar el request 3 (Crear solicitud)"
		}
	],
	"item": [
		{
			"name": "1. Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/health",
					"host": ["{{base_url}}"],
					"path": ["health"]
				},
				"description": "Verifica que la API está en línea. Responde 200 {\"status\": \"ok\"} siempre."
			},
			"response": []
		},
		{
			"name": "2. DB Readiness Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/health/ready",
					"host": ["{{base_url}}"],
					"path": ["health", "ready"]
				},
				"description": "Verifica la conexión activa con PostgreSQL. Responde 200 si la BD está disponible, 503 si no."
			},
			"response": []
		},
		{
			"name": "3. Crear Solicitud – Soporte Técnico (201)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var json = pm.response.json();",
							"// La API retorna external_id como identificador público",
							"pm.collectionVariables.set('request_id', json.external_id);",
							"pm.test('Status 201 Created', function(){ pm.response.to.have.status(201); });",
							"pm.test('Estado inicial es received', function(){ pm.expect(json.status).to.eql('received'); });",
							"pm.test('external_id presente', function(){ pm.expect(json.external_id).to.be.a('string'); });",
							"pm.test('Tipo correcto', function(){ pm.expect(json.type).to.eql('technical_support'); });"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{"key": "Content-Type", "value": "application/json", "type": "text"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"external_id\": \"123e4567-e89b-12d3-a456-426614174001\",\n    \"type\": \"technical_support\",\n    \"requester_name\": \"Test User\",\n    \"email\": \"test.user@example.com\",\n    \"description\": \"No puedo acceder al sistema de notas desde ayer en la mañana\",\n    \"priority\": \"high\"\n}",
					"options": {"raw": {"language": "json"}}
				},
				"url": {
					"raw": "{{base_url}}/api/v1/requests",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "requests"]
				},
				"description": "Crea una nueva solicitud institucional. Guarda automáticamente `external_id` en la variable de colección `request_id`."
			},
			"response": []
		},
